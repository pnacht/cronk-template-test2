name: "CodeQL"

on:
  push:
    branches: ["main"]
  pull_request:
    branches: ["main"]
  schedule:
    - cron: '31 6 * * 1'
  workflow_dispatch:

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  analyze:
    name: Analyze
    runs-on: ubuntu-latest

    permissions:
      actions: read
      contents: read
      security-events: write

    steps:
      - name: Checkout repository
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false

      - name: Initialize CodeQL
        uses: github/codeql-action/init@a3d1b7713d35ad8fb8e1d50cad890efbadb49cbb # v3.39.2
        with:
          languages: python
          queries: security-and-quality

      - name: Autobuild
        uses: github/codeql-action/autobuild@a3d1b7713d35ad8fb8e1d50cad890efbadb49cbb # v3.39.2

      - name: Perform CodeQL Analysis
        uses: github/codeql-action/analyze@a3d1b7713d35ad8fb8e1d50cad890efbadb49cbb # v3.39.2
        with:
          category: "/language:python"
